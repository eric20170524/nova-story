# ComfyUI Mode Configuration
# Options: 'local' | 'remote'
COMFYUI_MODE=remote

# Remote ComfyUI Credentials & URL
COMFYUI_REMOTE_URL=https://your-remote-comfyui.example.com
COMFYUI_REMOTE_USERNAME=
COMFYUI_REMOTE_PASSWORD=

# Local ComfyUI URL (Optional override, defaults to http://127.0.0.1:8188)
COMFYUI_LOCAL_URL=http://127.0.0.1:8188
