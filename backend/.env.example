# Database Configuration
DATABASE_URL=sqlite:///./sql_app.db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# General Settings
PROJECT_NAME=NovaStory

# LLM — local-first (Ollama OpenAI-compatible). See docs/local_language_model_deployment_cn.md
LLM_PROVIDER=ollama
LLM_API_KEY=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=novastory-qwen3:8b

# Optional cloud providers (set LLM_PROVIDER=gemini|openai|grok and fill keys)
# LLM_PROVIDER=gemini
# LLM_API_KEY=
# LLM_MODEL=gemini-2.5-flash

# API Keys (Used by config.ts)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROK_API_KEY=

# Cloud & specific integrations
GOOGLE_CLOUD_PROJECT_ID=
AI_IMAGE_PROVIDER=gemini

# Nebula V2 Integration
NEBULA_API_URL=https://api.chuangyi.chat/api/v1
NEBULA_JWT_SECRET=
