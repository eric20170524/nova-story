{
  "name": "backend",
  "version": "1.0.0",
  "description": "NovaStory API server (Fastify + SQLite)",
  "main": "dist/server.js",
  "scripts": {
    "test": "tsx scripts/run-tests.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['dist','logs','.pytest_cache']) { try { fs.rmSync(p,{recursive:true,force:true}); console.log('removed',p); } catch {} }\""
  },
  "keywords": [
    "novastory"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "@fastify/websocket": "^11.3.0",
    "@google/genai": "*",
    "@types/pdfkit": "^0.17.6",
    "dotenv": "^17.4.2",
    "eventemitter3": "^5.0.4",
    "fastify": "^5.10.0",
    "ioredis": "^5.11.1",
    "mammoth": "^1.12.1",
    "openai": "^6.49.0",
    "pdfkit": "^0.19.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.3",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "ws": "^8.21.1",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "^5.8.2"
  }
}
