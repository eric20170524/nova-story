{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux1-dev.safetensors",
      "weight_dtype": "default"
    },
    "_meta": { "title": "Load Diffusion Model (FLUX.1-dev)" }
  },
  "2": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "t5xxl_fp16.safetensors",
      "clip_name2": "clip_l.safetensors",
      "type": "flux"
    },
    "_meta": { "title": "DualCLIPLoader (FLUX T5 + CLIP-L)" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ae.safetensors"
    },
    "_meta": { "title": "Load VAE (FLUX)" }
  },
  "4": {
    "class_type": "CLIPTextEncodeFlux",
    "inputs": {
      "clip": ["2", 0],
      "clip_l": "masterpiece, best quality, cinematic",
      "t5xxl": "masterpiece, best quality, cinematic",
      "guidance": 3.5
    },
    "_meta": { "title": "CLIP Text Encode (Flux)" }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 576,
      "batch_size": 1
    },
    "_meta": { "title": "Empty Latent Image (16:9)" }
  },
  "6": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "positive": ["4", 0],
      "negative": ["4", 0],
      "latent_image": ["5", 0],
      "seed": 0,
      "steps": 20,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1
    },
    "_meta": { "title": "KSampler (FLUX)" }
  },
  "7": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["6", 0],
      "vae": ["3", 0]
    },
    "_meta": { "title": "VAE Decode" }
  },
  "8": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "NovaStoryFluxDev",
      "images": ["7", 0]
    },
    "_meta": { "title": "Save Image" }
  }
}
